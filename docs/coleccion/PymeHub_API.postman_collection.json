                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "try { pm.collectionVariables.set('empresa_id', j.data.id); } catch (e) {}",
