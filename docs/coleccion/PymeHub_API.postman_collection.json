              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Reparto Rápido Castilla S.L.\",\n  \"nif\": \"B12345678\",\n  \"plan\": \"COMPLETO\",\n  \"ciclo_cobro\": \"MENSUAL\",\n  \"limite_empleados\": 60,\n  \"fecha_contrato_encargado\": \"2026-10-01\",\n  \"estado\": \"PILOTO\",\n  \"gerente\": {\n    \"nombre\": \"Ana\",\n    \"apellidos\": \"García\",\n    \"email\": \"gerente@castilla.test\"\n  }\n}",
              "options": {
