    {
      "name": "08 · Bienestar del empleado (EMPLEADO)",
      "description": "Inicia sesión con un usuario EMPLEADO (en los datos de demo, conductor@pymehub.demo).",
      "item": [
        {
          "name": "Check-in del día",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/me/checkins",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "me",
                "checkins"
              ]
            },
            "description": "RF-050/RF-051. Repetirlo actualiza el del día. 'fecha' opcional (hasta 3 días atrás, para la cola sin conexión). Con valores bajos devuelve 'apoyo' (RF-055).",
            "body": {
